<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development (hot reload, debugging). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Debug builds only: allow plain HTTP to a local backend (http://10.0.2.2:8000).
         Release builds are HTTPS-only. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic"/>
</manifest>
