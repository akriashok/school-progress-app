# Used by `docker compose --profile app up` (local dev only).
ENV=local
DATABASE_URL=postgresql+psycopg://app_user:app_user_dev@postgres:5432/vidyatrack
MIGRATION_DATABASE_URL=postgresql+psycopg://vidya_owner:vidya_owner_dev@postgres:5432/vidyatrack
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-docker-dev-secret-not-for-production-use-0123456789
DEV_OTP_ENABLED=true
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=/app/.storage
CORS_ORIGINS=["http://localhost:3000"]
