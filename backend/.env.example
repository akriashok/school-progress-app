# Copy to .env for local development. Never commit real secrets.
ENV=local
DATABASE_URL=postgresql+psycopg://app_user:app_user_dev@localhost:5433/vidyatrack
MIGRATION_DATABASE_URL=postgresql+psycopg://vidya_owner:vidya_owner_dev@localhost:5433/vidyatrack
APP_DB_ROLE=app_user
REDIS_URL=redis://localhost:6380/0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-for-local-dev-only
# Dev only: logs OTPs to the console and accepts 123456. Refused in staging/production.
DEV_OTP_ENABLED=true
SMS_BACKEND=console
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=.storage
PUSH_BACKEND=log
CORS_ORIGINS=["http://localhost:3000"]
